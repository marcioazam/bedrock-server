{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "vp:dragonfly_nymph",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/vp/dragonfly/nymph"
      },
      "geometry": {
        "default": "geometry.vp.dragonfly_nymph"
      },
      "animations": {
        "idle": "animation.vp.dragonfly_nymph.idle",
        "idle_groom": "animation.vp.dragonfly_nymph.idle_groom",
        "idle_pulse": "animation.vp.dragonfly_nymph.idle_pulse",
        "swim": "animation.vp.dragonfly_nymph.swim",
        "walk": "animation.vp.dragonfly_nymph.walk",
        "drift": "animation.vp.dragonfly_nymph.drift",
        "emerge": "animation.vp.dragonfly_nymph.emerge",
        "spawn": "animation.vp.dragonfly_nymph.spawn",
        "hurt": "animation.vp.dragonfly_nymph.hurt",
        "death": "animation.vp.dragonfly_nymph.death",
        "blink": "animation.vp.dragonfly_nymph.blink",
        "eyes_shut": "animation.vp.dragonfly_nymph.eyes_shut",
        "look": "animation.vp.dragonfly_nymph.look",
        "root": "controller.animation.vp.dragonfly_nymph.root",
        "posture": "controller.animation.vp.dragonfly_nymph.posture",
        "flinch": "controller.animation.vp.dragonfly_nymph.flinch",
        "blinking": "controller.animation.vp.dragonfly_nymph.blinking",
        "spawning": "controller.animation.vp.dragonfly_nymph.spawning",
        "fidget": "controller.animation.vp.dragonfly_nymph.fidget"
      },
      "scripts": {
        "initialize": [
          "v.speed = 0;",
          "v.water = 1;",
          "v.pitch = 0;",
          "v.dead = 0;",
          "v.blink_wait = 3;",
          "v.bank = 0;",
          "v.dyaw = 0;",
          "v.yaw_last = q.body_y_rotation;",
          "v.sdt = 0.0167;",
          "v.look = 0;"
        ],
        "pre_animation": [
          "v.sdt = math.min(q.delta_time, 0.1);",
          "v.speed = math.min(q.modified_move_speed, 1);",
          "v.water = v.water + ((q.is_in_water ? 1 : 0) - v.water) * (1 - math.exp(-8 * v.sdt));",
          "v.pitch = v.pitch + ((math.clamp(q.vertical_speed * (q.is_in_water ? 8 : 3), -18, 18)) - v.pitch) * (1 - math.exp(-8 * v.sdt));",
          "v.dead = q.is_alive ? 0 : v.dead + v.sdt;",
          "v.dyaw = q.body_y_rotation - v.yaw_last;",
          "v.dyaw = v.dyaw - 360 * math.round(v.dyaw / 360);",
          "v.yaw_last = q.body_y_rotation;",
          "v.bank = v.bank + ((math.clamp(v.dyaw / math.max(v.sdt, 0.005) * 0.045, -12, 12)) - v.bank) * (1 - math.exp(-6 * v.sdt));",
          "v.look = v.look + ((q.distance_from_camera < 8 ? (1) : 0) - v.look) * (1 - math.exp(-6 * v.sdt));"
        ],
        "animate": [
          "root"
        ]
      },
      "render_controllers": [
        "controller.render.vp.dragonfly_nymph"
      ]
    }
  }
}
