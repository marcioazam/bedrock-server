{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.vp.dragonfly.root": {
      "initial_state": "alive",
      "states": {
        "alive": {
          "animations": [
            "posture",
            "wings",
            "look",
            "flinch",
            "blinking",
            "spawning",
            "fidget"
          ],
          "blend_transition": {
            "0.000": 1.0,
            "0.030": 0.512,
            "0.060": 0.216,
            "0.090": 0.064,
            "0.120": 0.008,
            "0.150": 0.0
          },
          "blend_via_shortest_path": true,
          "transitions": [
            {
              "dead": "!q.is_alive"
            }
          ]
        },
        "dead": {
          "animations": [
            "death",
            "eyes_shut",
            {
              "wings": "math.pow(1 - math.clamp(v.dead, 0, 1), 3)"
            }
          ],
          "blend_transition": {
            "0.000": 1.0,
            "0.030": 0.512,
            "0.060": 0.216,
            "0.090": 0.064,
            "0.120": 0.008,
            "0.150": 0.0
          },
          "blend_via_shortest_path": true,
          "transitions": [
            {
              "alive": "q.is_alive"
            }
          ]
        }
      }
    },
    "controller.animation.vp.dragonfly.blinking": {
      "initial_state": "open",
      "states": {
        "open": {
          "on_entry": [
            "v.blink_wait = math.random(2, 6);"
          ],
          "transitions": [
            {
              "blink": "q.state_time > v.blink_wait"
            }
          ]
        },
        "blink": {
          "animations": [
            "blink"
          ],
          "transitions": [
            {
              "open": "q.any_animation_finished"
            }
          ]
        }
      }
    },
    "controller.animation.vp.dragonfly.spawning": {
      "initial_state": "pop",
      "states": {
        "pop": {
          "animations": [
            "spawn"
          ],
          "transitions": [
            {
              "done": "q.any_animation_finished"
            }
          ]
        },
        "done": {}
      }
    },
    "controller.animation.vp.dragonfly.posture": {
      "initial_state": "ground",
      "states": {
        "ground": {
          "animations": [
            "idle"
          ],
          "blend_transition": {
            "0.000": 1.0,
            "0.030": 0.512,
            "0.060": 0.216,
            "0.090": 0.064,
            "0.120": 0.008,
            "0.150": 0.0
          },
          "blend_via_shortest_path": true,
          "transitions": [
            {
              "takeoff": "!q.is_on_ground"
            },
            {
              "walk": "q.modified_move_speed > 0.05"
            }
          ]
        },
        "walk": {
          "animations": [
            "walk"
          ],
          "blend_transition": {
            "0.000": 1.0,
            "0.030": 0.512,
            "0.060": 0.216,
            "0.090": 0.064,
            "0.120": 0.008,
            "0.150": 0.0
          },
          "blend_via_shortest_path": true,
          "transitions": [
            {
              "takeoff": "!q.is_on_ground"
            },
            {
              "ground": "q.modified_move_speed <= 0.05"
            }
          ]
        },
        "takeoff": {
          "animations": [
            "takeoff",
            "air"
          ],
          "blend_transition": {
            "0.000": 1.0,
            "0.030": 0.512,
            "0.060": 0.216,
            "0.090": 0.064,
            "0.120": 0.008,
            "0.150": 0.0
          },
          "blend_via_shortest_path": true,
          "transitions": [
            {
              "air": "q.state_time >= 0.4546"
            }
          ]
        },
        "air": {
          "animations": [
            "air"
          ],
          "blend_transition": {
            "0.000": 1.0,
            "0.030": 0.512,
            "0.060": 0.216,
            "0.090": 0.064,
            "0.120": 0.008,
            "0.150": 0.0
          },
          "blend_via_shortest_path": true,
          "transitions": [
            {
              "land": "q.is_on_ground"
            }
          ]
        },
        "land": {
          "animations": [
            "land",
            "idle"
          ],
          "blend_transition": {
            "0.000": 1.0,
            "0.030": 0.512,
            "0.060": 0.216,
            "0.090": 0.064,
            "0.120": 0.008,
            "0.150": 0.0
          },
          "blend_via_shortest_path": true,
          "transitions": [
            {
              "takeoff": "!q.is_on_ground"
            },
            {
              "ground": "q.state_time >= 0.4546"
            }
          ]
        }
      }
    },
    "controller.animation.vp.dragonfly.fidget": {
      "initial_state": "off",
      "states": {
        "off": {
          "transitions": [
            {
              "idle_wait": "q.is_on_ground && q.modified_move_speed <= 0.05"
            }
          ]
        },
        "idle_wait": {
          "on_entry": [
            "v.idle_pick = math.random_integer(0, 1);",
            "v.idle_wait = math.random(1.5, 4.5);"
          ],
          "transitions": [
            {
              "off": "!q.is_on_ground || q.modified_move_speed > 0.05"
            },
            {
              "idle_0": "v.idle_pick == 0 && q.state_time > v.idle_wait"
            },
            {
              "idle_1": "v.idle_pick == 1 && q.state_time > v.idle_wait"
            }
          ]
        },
        "idle_0": {
          "animations": [
            "idle_groom"
          ],
          "blend_transition": 0.24,
          "transitions": [
            {
              "off": "!q.is_on_ground || q.modified_move_speed > 0.05"
            },
            {
              "idle_wait": "q.any_animation_finished"
            }
          ]
        },
        "idle_1": {
          "animations": [
            "idle_twitch"
          ],
          "blend_transition": 0.24,
          "transitions": [
            {
              "off": "!q.is_on_ground || q.modified_move_speed > 0.05"
            },
            {
              "idle_wait": "q.any_animation_finished"
            }
          ]
        }
      }
    },
    "controller.animation.vp.dragonfly.flinch": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "hurt": "q.hurt_time > 0 && q.is_alive"
            }
          ]
        },
        "hurt": {
          "animations": [
            "hurt",
            "blink"
          ],
          "transitions": [
            {
              "default": "q.state_time >= 0.5 && q.hurt_time <= 0"
            }
          ]
        }
      }
    }
  }
}
